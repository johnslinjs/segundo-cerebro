{
  "provider": "github",
  "owner": "johnslinjs",
  "repo": "segundo-cerebro",
  "branch": "main",
  "mode": "sync",
  "syncOnStartup": true,
  "syncOnChange": true,
  "changeDebounceSec": 10,
  "intervalMin": 1,
  "syncOnResume": true,
  "syncOnBackground": true,
  "syncConfigDir": true,
  "configSync": {
    "appearance": true,
    "snippets": true,
    "hotkeys": true,
    "core": true,
    "pluginList": true,
    "pluginCode": true,
    "pluginSettings": true,
    "plugins": {},
    "installFromReleases": false
  },
  "syncHidden": false,
  "syncHiddenNested": false,
  "useGitignore": false,
  "excludePatterns": "# One pattern per line, gitignore style\n.trash/\n.DS_Store\nThumbs.db\n{config}/workspace.json\n{config}/workspace-mobile.json\n{config}/workspaces.json\n{config}/cache\n{config}/plugins/*/node_modules/",
  "maxFileSizeMB": 50,
  "lfsThresholdMB": 0,
  "conflictStrategy": "auto",
  "reviewBeforeManualSync": false,
  "ignoreLineEndingChanges": true,
  "fullScanMinutes": 30,
  "deleteGuardEnabled": true,
  "deleteGuardMin": 10,
  "deleteGuardPercent": 20,
  "dailySnapshot": false,
  "commitTemplate": "{{device}}: {{summary}}",
  "commitTemplateAuto": "",
  "repoSubdir": "",
  "statusCountdown": false,
  "statusBranch": false,
  "respectFrontmatter": true,
  "authorName": "",
  "authorEmail": "",
  "keepEmptyFolders": true,
  "mirror": null,
  "noticeLevel": "auto",
  "syncOnOpen": true,
  "explorerBadges": true,
  "changeMarkers": true,
  "wizardShown": true,
  "sharedFolders": []
}